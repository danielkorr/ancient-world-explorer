{
  "name": "ancient-world-explorer-devtools",
  "private": true,
  "description": "Local dev-only tooling for VIA. The site itself has no build; this exists so the webkit-touch test can install Playwright and to hold the data-regeneration scripts. Not shipped.",
  "scripts": {
    "test:webkit": "node tests/webkit-touch/test.mjs",

    "research:snapshot": "node research-lab/snapshot.mjs",
    "research:snapshot:all": "node research-lab/snapshot-all.mjs",
    "research:pilot": "node research-lab/run-pilot.mjs",
    "research:alexander": "node research-lab/run-alexander.mjs",
    "research:test": "node --test research-lab/tests/*.test.mjs",
    "research:serve": "node research-lab/observatory/server.mjs",

    "regen:photos": "node scripts/detect-pleiades-photos.mjs",
    "regen:site-photos": "node scripts/build-site-photos.mjs",
    "regen:vici-sites": "node --max-old-space-size=4096 scripts/build-elevation-worklist.mjs --emit-sites",
    "regen:sites": "node scripts/build-sites.mjs",
    "regen:vici-links": "node scripts/build-vici-links.mjs",
    "regen:linked-data": "node scripts/build-linked-data.mjs",
    "regen:orbis": "node scripts/build-orbis.mjs",
    "regen:roads": "node scripts/build-roads.mjs",
    "regen:alex-photos": "node scripts/build-alexander-photos.mjs",
    "regen:coverage-photos": "node scripts/build-coverage-photos.mjs",

    "regen:sites-all": "npm run regen:photos && npm run regen:vici-sites && npm run regen:sites && npm run regen:vici-links && npm run regen:linked-data",
    "regen:all": "npm run regen:sites-all && npm run regen:orbis && npm run regen:roads && npm run regen:coverage-photos"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
